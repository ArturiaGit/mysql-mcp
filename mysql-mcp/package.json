    "test": "node scripts/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@napi-rs/keyring": "2.1.0",
    "fastify": "5.12.5",
    "mysql2": "3.24.5",
    "node-sql-parser": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
