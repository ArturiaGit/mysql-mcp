{
  "name": "mysql-mcp-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.22.0",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc -b",
    "typecheck": "tsc -b --force && pnpm --filter @mysql-mcp/admin-ui typecheck",
    "lint": "eslint . && node scripts/m0/check-workspace.mjs",
    "test": "pnpm build && node --test tests/foundation.test.mjs tests/auth-domain.test.mjs tests/pat-token.test.mjs",
    "test:integration": "pnpm build && node --test tests/mysql.integration.mjs",
    "test:m1": "pnpm build && node --test tests/m1.integration.mjs",
    "test:m2": "pnpm build && node --test tests/m2.integration.mjs",
    "test:guardrails": "node --test tests/guardrails.test.mjs",
    "ci:frontend": "node scripts/m0/frontend-budget.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "fastify": "5.12.8",
    "mysql2": "3.24.6",
    "node-sql-parser": "5.4.0",
    "ssh2": "1.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@types/node": "22.19.15",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
